               swipeArg: {
                 start: {
                  x: '540',
                  y: '1700'
                 },
                 end: {
                  x: '540',
                  y: '500'
                 },
                 duration: 100
               },
               matches: [
                '[text="上滑继续观看"||text="上滑继续观看视频"]'
               ],
             }
           ]
         }
       ]
     },
